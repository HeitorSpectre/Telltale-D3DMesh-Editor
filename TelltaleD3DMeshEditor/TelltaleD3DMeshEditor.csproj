<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TelltaleD3DMeshEditor</RootNamespace>
    <AssemblyName>TelltaleD3DMeshEditor</AssemblyName>
    <ApplicationIcon>Resources\Icons\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Stamp the build time as a UTC instant into the assembly. The window converts it to the user's
       local timezone at runtime, so the displayed build time is correct everywhere (a file timestamp
       would not survive zipping, which stores timezone-naive local times). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>BuildTimestampUtc</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- TelltaleToolKit (git submodule at /external/TelltaleToolKit) — used to open and
       extract .ttarch / .ttarch2 game containers so users don't have to unpack them manually.
       Referenced from source so it stays linked to the upstream repo via the submodule. -->
  <ItemGroup>
    <ProjectReference Include="..\external\TelltaleToolKit\src\TelltaleToolKit\TelltaleToolKit.csproj" />
  </ItemGroup>

  <!-- Telltale hash databases (BoneNames/TexNames) embedded in the tool
       (Resources/HashDBs) and copied next to the .exe. Everything is offline and self-contained,
       with no dependency on external folders, so the tool can be distributed on its own. -->
  <ItemGroup>
    <None Include="Resources\HashDBs\BoneNames.HashDB" Link="HashDBs\BoneNames.HashDB">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\HashDBs\TexNames.HashDB" Link="HashDBs\TexNames.HashDB">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Resources\Icons\d3dmesh.ico">
      <LogicalName>TelltaleD3DMeshEditor.Resources.Icons.D3DMesh.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Icons\skl.ico">
      <LogicalName>TelltaleD3DMeshEditor.Resources.Icons.Skeleton.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Icons\logo - issue.ico">
      <LogicalName>TelltaleD3DMeshEditor.Resources.Icons.Issue.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Images\drag and drop.png">
      <LogicalName>TelltaleD3DMeshEditor.Resources.Images.DragDrop.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Images\Logo Background.png">
      <LogicalName>TelltaleD3DMeshEditor.Resources.Images.LogoBackground.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Images\BTTF101.png">
      <LogicalName>TelltaleD3DMeshEditor.Resources.Images.BTTF101.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Images\BTTF102.png">
      <LogicalName>TelltaleD3DMeshEditor.Resources.Images.BTTF102.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Images\BTTF103.png">
      <LogicalName>TelltaleD3DMeshEditor.Resources.Images.BTTF103.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Images\BTTF104.png">
      <LogicalName>TelltaleD3DMeshEditor.Resources.Images.BTTF104.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Images\BTTF105.png">
      <LogicalName>TelltaleD3DMeshEditor.Resources.Images.BTTF105.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
