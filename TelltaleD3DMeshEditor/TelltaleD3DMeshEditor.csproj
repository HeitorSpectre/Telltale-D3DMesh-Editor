<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TelltaleD3DMeshEditor</RootNamespace>
    <AssemblyName>TelltaleD3DMeshEditor</AssemblyName>
    <ApplicationIcon>Resources\Icons\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- TelltaleToolKit (git submodule at /external/TelltaleToolKit) — used to open and
       extract .ttarch / .ttarch2 game containers so users don't have to unpack them manually.
       Referenced from source so it stays linked to the upstream repo via the submodule. -->
  <ItemGroup>
    <ProjectReference Include="..\external\TelltaleToolKit\src\TelltaleToolKit\TelltaleToolKit.csproj" />
  </ItemGroup>

  <!-- Telltale hash databases (BoneNames/TexNames) embedded in the tool
       (Resources/HashDBs) and copied next to the .exe. Everything is offline and self-contained,
       with no dependency on external folders, so the tool can be distributed on its own. -->
  <ItemGroup>
    <None Include="Resources\HashDBs\BoneNames.HashDB" Link="HashDBs\BoneNames.HashDB">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\HashDBs\TexNames.HashDB" Link="HashDBs\TexNames.HashDB">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
